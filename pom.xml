<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mdviewer</groupId>
    <artifactId>mdviewer</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>MDViewer</name>
    <description>Professional Markdown Desktop Application</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <javafx.version>21</javafx.version>
        <!--
            Appended to the distribution jar's name. Empty by default, so a plain
            `mvn package` still produces mdviewer-1.0.0.jar for whoever is working on
            it. A release profile sets both this and javafx.platform together - see
            the profiles at the end of this file.
        -->
        <dist.suffix></dist.suffix>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-web</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark</artifactId>
            <version>0.21.0</version>
        </dependency>
        <dependency>
            <groupId>org.commonmark</groupId>
            <artifactId>commonmark-ext-gfm-tables</artifactId>
            <version>0.21.0</version>
        </dependency>
        <!--
            MIT-licensed PlantUML build (matches this project's licence). Ships the C4
            standard library and the pure-Java "smetana" layout engine, so diagrams render
            with no Graphviz install and no network access.
        -->
        <dependency>
            <groupId>net.sourceforge.plantuml</groupId>
            <artifactId>plantuml-mit</artifactId>
            <version>1.2026.6</version>
        </dependency>
        <!--
            Syntax highlighting for fenced code blocks. Taken as a webjar so the script
            travels inside the shaded jar like the mermaid bundle does: this is an offline
            app, and a highlighter fetched from a CDN would simply never load.

            Only the script is used. highlight.js ships themes as CSS, but the preview has
            its own palette and a borrowed theme would clash with the plates it sits in,
            so the token colours are defined alongside the rest of the preview CSS.
        -->
        <dependency>
            <groupId>org.webjars</groupId>
            <artifactId>highlightjs</artifactId>
            <version>11.11.1</version>
        </dependency>

        <!--
            Tests. Until now this project had none in the repository: verification was done
            with throwaway harnesses that were lost with the session that wrote them, so
            nothing checked twice was ever checked again.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!--
                        The application is a JavaFX module; the tests are not, and putting
                        them on the module path would mean opening packages to a test
                        framework purely so it can reach them. Classpath keeps the shipped
                        module declaration describing the application rather than its tests.
                    -->
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>com.mdviewer.MainApp</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.mdviewer.Launcher</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!--
                Standalone distribution: bundles JavaFX (including its native libraries),
                commonmark, PlantUML and the mermaid build into one runnable jar, so
                `java -jar target/mdviewer-1.0.0.jar` needs nothing but a JRE 21.
                The bundled natives are platform specific, and which ones get bundled is
                decided by javafx.platform - which defaults to the machine doing the build.
                That default is how release 1.0.0 shipped a Windows-only jar: on Linux it
                failed with "Error initializing QuantumRenderer: no suitable pipeline found",
                which names graphics pipelines and not the actual cause. Release builds must
                pass -P<platform> so the choice is made on purpose rather than by accident.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <finalName>mdviewer-${project.version}${dist.suffix}</finalName>
                            <shadedArtifactAttached>false</shadedArtifactAttached>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.mdviewer.Launcher</mainClass>
                                </transformer>
                                <!-- JavaFX and PlantUML both look services up via ServiceLoader. -->
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Module descriptors are meaningless on the classpath and collide. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                        <!-- Signatures break once jars are merged. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!--
        Which natives get bundled is decided by the javafx.platform property, and it has
        to arrive as -D on the command line: the OpenJFX artifacts choose their classifier
        through profile activation in their own pom, and that only ever sees system
        properties. Setting javafx.platform in a profile here names the jar correctly and
        packages the wrong libraries - a Linux-named jar full of DLLs, which fails at the
        user rather than at the build.

        So these profiles activate *from* that property and only supply the matching name.
        One flag, and the name and the contents cannot disagree:

            mvn clean package -DskipTests -Djavafx.platform=linux
            mvn clean package -DskipTests -Djavafx.platform=win
            mvn clean package -DskipTests -Djavafx.platform=mac-aarch64

        Cross-building is fine - these are ordinary downloads, so every platform builds on
        any machine. Each run overwrites target/, so copy the jar out between builds.

        With no -D at all, nothing is appended and the jar is built for this machine, which
        is what you want while working on it and is never what you want for a release.
    -->
    <profiles>
        <profile>
            <id>win</id>
            <activation>
                <property><name>javafx.platform</name><value>win</value></property>
            </activation>
            <properties><dist.suffix>-win</dist.suffix></properties>
        </profile>
        <profile>
            <id>linux</id>
            <activation>
                <property><name>javafx.platform</name><value>linux</value></property>
            </activation>
            <properties><dist.suffix>-linux</dist.suffix></properties>
        </profile>
        <profile>
            <!-- Raspberry Pi and other 64-bit ARM Linux. -->
            <id>linux-aarch64</id>
            <activation>
                <property><name>javafx.platform</name><value>linux-aarch64</value></property>
            </activation>
            <properties><dist.suffix>-linux-aarch64</dist.suffix></properties>
        </profile>
        <profile>
            <!-- Intel Macs. -->
            <id>mac</id>
            <activation>
                <property><name>javafx.platform</name><value>mac</value></property>
            </activation>
            <properties><dist.suffix>-mac</dist.suffix></properties>
        </profile>
        <profile>
            <!-- Apple silicon. -->
            <id>mac-aarch64</id>
            <activation>
                <property><name>javafx.platform</name><value>mac-aarch64</value></property>
            </activation>
            <properties><dist.suffix>-mac-aarch64</dist.suffix></properties>
        </profile>
    </profiles>
</project>
