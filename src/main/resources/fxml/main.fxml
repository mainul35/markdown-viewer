<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.input.KeyCodeCombination?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mdviewer.MainController">
    <top>
        <VBox>
            <MenuBar>
            <!--
                "shortcut" rather than "control" so the accelerator is Ctrl on Windows and
                Linux and Cmd on macOS, which is what each platform's users press.
            -->
                <Menu text="File">
                    <MenuItem text="New" onAction="#handleNewFile">
                        <accelerator><KeyCodeCombination alt="UP" code="N" control="UP" meta="UP" shift="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <MenuItem text="Open..." onAction="#handleOpenFile">
                        <accelerator><KeyCodeCombination alt="UP" code="O" control="UP" meta="UP" shift="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <MenuItem text="Open Folder..." onAction="#handleOpenFolder">
                        <accelerator><KeyCodeCombination alt="UP" code="O" control="UP" meta="UP" shift="DOWN" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <MenuItem text="Save" onAction="#handleSaveFile">
                        <accelerator><KeyCodeCombination alt="UP" code="S" control="UP" meta="UP" shift="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <MenuItem text="Save As..." onAction="#handleSaveAs">
                        <accelerator><KeyCodeCombination alt="UP" code="S" control="UP" meta="UP" shift="DOWN" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <SeparatorMenuItem/>
                    <!--
                        Filled in at runtime from ~/.mdviewer/workspaces.txt. Rebuilt each
                        time it is shown rather than kept in step with every open and
                        close, which is one place to get wrong instead of several.
                    -->
                    <Menu fx:id="recentWorkspacesMenu" text="Recent Workspaces"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Close Document" onAction="#handleCloseDocument">
                        <accelerator><KeyCodeCombination alt="UP" code="W" control="UP" meta="UP" shift="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <MenuItem text="Close Workspace" onAction="#handleCloseWorkspace"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Exit" onAction="#handleExit"/>
                </Menu>
                <Menu text="Edit">
                    <!--
                        Undo and Redo are menu items rather than left to the editor's own
                        key handling, because the editor is not always what has focus: a
                        formatting action taken in the preview edits the document, and
                        Ctrl+Z pressed with the preview focused went to the WebView, which
                        has nothing to undo.
                    -->
                    <MenuItem text="Undo" onAction="#handleUndo">
                        <accelerator><KeyCodeCombination alt="UP" code="Z" control="UP" meta="UP" shift="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <MenuItem text="Redo" onAction="#handleRedo">
                        <accelerator><KeyCodeCombination alt="UP" code="Z" control="UP" meta="UP" shift="DOWN" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <SeparatorMenuItem/>
                    <MenuItem text="Find..." onAction="#handleFind">
                        <accelerator><KeyCodeCombination alt="UP" code="F" control="UP" meta="UP" shift="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <MenuItem text="Find and Replace..." onAction="#handleFindReplace">
                        <accelerator><KeyCodeCombination alt="UP" code="H" control="UP" meta="UP" shift="UP" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                </Menu>
                <Menu text="View">
                    <MenuItem text="Raw Editor" onAction="#handleRawMode"/>
                    <MenuItem text="Split Preview" onAction="#handleSplitMode"/>
                    <MenuItem text="Full Preview" onAction="#handleFullPreviewMode"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="explorerMenuItem" text="Hide Explorer" onAction="#handleToggleExplorer"/>
                    <MenuItem text="Reveal Current File" onAction="#handleRevealInTree"/>
                    <CheckMenuItem fx:id="touchScrollMenuItem" text="Drag to Scroll (Touchscreen)"
                                   onAction="#handleToggleTouchScroll"/>
                    <MenuItem fx:id="assistantMenuItem" text="Show Assistant" onAction="#handleToggleAssistant">
                        <accelerator><KeyCodeCombination alt="UP" code="A" control="UP" meta="UP" shift="DOWN" shortcut="DOWN"/></accelerator>
                    </MenuItem>
                    <MenuItem text="Refresh Workspaces" onAction="#handleRefreshWorkspaces">
                        <accelerator><KeyCodeCombination alt="UP" code="F5" control="UP" meta="UP" shift="UP" shortcut="UP"/></accelerator>
                    </MenuItem>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="themeMenuItem" text="Dark Mode" onAction="#handleToggleTheme"/>
                </Menu>
                <!--
                    Auto-refresh is on by default: a stale tree is a silent wrong answer,
                    and the cost is one directory listing every five minutes. It is a
                    toggle rather than a fixed behaviour because a workspace on a network
                    share or a very large tree is exactly where the scan stops being free.
                -->
                <Menu text="Settings">
                    <MenuItem text="AI Providers..." onAction="#handleProviderSettings"/>
                    <MenuItem text="Sign In to Cloud..." onAction="#handleCloudSignIn"/>
                    <MenuItem text="Sign Out of Cloud" onAction="#handleCloudSignOut"/>
                    <SeparatorMenuItem/>
                    <MenuItem text="Cloud Sync..." onAction="#handleCloudSync"/>
                    <MenuItem text="Sync Settings to Cloud..." onAction="#handleCloudSettingsSync"/>
                    <CheckMenuItem fx:id="cloudAutoSyncMenuItem" text="Sync Workspaces Automatically" selected="true" onAction="#handleToggleCloudAutoSync"/>
                    <SeparatorMenuItem/>
                    <CheckMenuItem fx:id="autoRefreshMenuItem" text="Auto-refresh Workspaces (5 min)" selected="true" onAction="#handleToggleAutoRefresh"/>
                </Menu>
                <Menu text="Help">
                    <MenuItem text="About" onAction="#handleAbout"/>
                </Menu>
            </MenuBar>
            <!--
                File actions live only in the File menu - duplicating them as buttons added
                no quick access the menu did not already give. The view buttons stay because
                switching modes is frequent, and are pushed right by the growing spacer.
            -->
            <ToolBar>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="rawModeButton" text="Raw" onAction="#handleRawMode"/>
                <Button fx:id="splitModeButton" text="Split" onAction="#handleSplitMode"/>
                <Button fx:id="previewModeButton" text="Preview" onAction="#handleFullPreviewMode"/>
                <Separator orientation="VERTICAL"/>
                <Button fx:id="themeButton" text="Dark Mode" minWidth="90" onAction="#handleToggleTheme"/>
            </ToolBar>
        </VBox>
    </top>

    <!--
        Explorer on the left, workspace tabs on the right. Each workspace tab's content is
        its own tab strip of open files, so documents stay grouped by where they came from.
        The shared editor/preview area is moved into whichever file tab is selected.
    -->
    <center>
        <SplitPane fx:id="mainSplit" dividerPositions="0.2">
            <StackPane fx:id="explorerHost"/>
            <TabPane fx:id="workspaceTabs" styleClass="workspace-tabs"/>
        </SplitPane>
    </center>

    <bottom>
        <!--
            The mode label grows, so anything after it sits against the right edge. That is
            where the sync indicator goes: it is the one thing here that is not always true,
            and putting it among the three facts that are would make them look changeable too.
        -->
        <HBox fx:id="statusBar" spacing="20" styleClass="status-bar">
            <Label fx:id="statusLabel" text="File: Untitled | Encoding: N/A"/>
            <Label fx:id="wordCountLabel" text="Words: 0"/>
            <Label fx:id="modeLabel" text="Mode: SPLIT" HBox.hgrow="ALWAYS"/>
        </HBox>
    </bottom>
</BorderPane>
